{
	"name": "Data_ingestion_loop_copy_1",
	"properties": {
		"activities": [
			{
				"name": "looping_tablename",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "get_table_names",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('get_table_names').output.value",
						"type": "Expression"
					},
					"batchCount": 10,
					"activities": [
						{
							"name": "current_timestamp",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "currentdate",
								"value": {
									"value": "@formatDateTime(utcNow(),'yyyyMMdd_HHmmss')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "loadtype_check",
							"type": "Switch",
							"dependsOn": [
								{
									"activity": "current_timestamp",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"on": {
									"value": "@toUpper(item().load_type)",
									"type": "Expression"
								},
								"cases": [
									{
										"value": "FULL",
										"activities": [
											{
												"name": "Execute Pipeline",
												"type": "ExecutePipeline",
												"dependsOn": [],
												"policy": {
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"pipeline": {
														"referenceName": "Full_load",
														"type": "PipelineReference"
													},
													"waitOnCompletion": true,
													"parameters": {
														"source_schema": {
															"value": "@item().source_schema",
															"type": "Expression"
														},
														"source_table": {
															"value": "@item().source_table",
															"type": "Expression"
														},
														"target_container": {
															"value": "@item().target_container",
															"type": "Expression"
														},
														"target_folder": {
															"value": "@item().target_folder",
															"type": "Expression"
														},
														"currentdate_file": {
															"value": "@variables('currentdate')",
															"type": "Expression"
														}
													}
												}
											}
										]
									},
									{
										"value": "INCREMENTAL",
										"activities": [
											{
												"name": "Copy_incremental",
												"type": "Copy",
												"dependsOn": [],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "AzureSqlSource",
														"sqlReaderQuery": {
															"value": "select * from @{item().source_schema}.@{item().source_table} where @{item().cdc_column} > '@{if(empty(pipeline().parameters.from_date),item().updated_at,pipeline().parameters.from_date)}'\n\n",
															"type": "Expression"
														},
														"queryTimeout": "02:00:00",
														"partitionOption": "None"
													},
													"sink": {
														"type": "ParquetSink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings"
														},
														"formatSettings": {
															"type": "ParquetWriteSettings"
														}
													},
													"enableStaging": false,
													"translator": {
														"type": "TabularTranslator",
														"typeConversion": true,
														"typeConversionSettings": {
															"allowDataTruncation": true,
															"treatBooleanAsNumber": false
														}
													}
												},
												"inputs": [
													{
														"referenceName": "DS_sql",
														"type": "DatasetReference"
													}
												],
												"outputs": [
													{
														"referenceName": "DS_ADLS_gen2",
														"type": "DatasetReference",
														"parameters": {
															"container": {
																"value": "@item().target_container",
																"type": "Expression"
															},
															"folder": {
																"value": "@item().target_folder",
																"type": "Expression"
															},
															"file": {
																"value": "@concat(item().source_table,'_',variables('currentdate'),'.parquet')",
																"type": "Expression"
															}
														}
													}
												]
											},
											{
												"name": "last_watermark",
												"type": "Lookup",
												"dependsOn": [
													{
														"activity": "Copy_incremental",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "AzureSqlSource",
														"sqlReaderQuery": {
															"value": "select max(@{item().cdc_column}) as cdc from @{item().source_schema}.@{item().source_table} where @{item().cdc_column} > '@{item().last_watermark}'",
															"type": "Expression"
														},
														"queryTimeout": "02:00:00",
														"partitionOption": "None"
													},
													"dataset": {
														"referenceName": "DS_sql",
														"type": "DatasetReference"
													}
												}
											},
											{
												"name": "update_control_ETL_incrmtl",
												"type": "Script",
												"dependsOn": [
													{
														"activity": "last_watermark",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"linkedServiceName": {
													"referenceName": "LS_Azuresql",
													"type": "LinkedServiceReference"
												},
												"typeProperties": {
													"scripts": [
														{
															"type": "Query",
															"text": {
																"value": "update dbo.control_ETL set status = 'Success', last_run_pipeline_id = '@{pipeline().RunId}', updated_at = getutcdate(), last_Watermark = @{activity('last_watermark').output.firstRow.cdc} where source_schema = '@{item().source_schema}' and source_table = '@{item().source_table}'",
																"type": "Expression"
															}
														}
													],
													"scriptBlockExecutionTimeout": "02:00:00"
												}
											},
											{
												"name": "incrmtl_fail_after_copy",
												"type": "Fail",
												"dependsOn": [
													{
														"activity": "update_control_ETL_incrmtl",
														"dependencyConditions": [
															"Failed"
														]
													}
												],
												"userProperties": [],
												"typeProperties": {
													"message": {
														"value": "Incremental load pipeline failed after copy",
														"type": "Expression"
													},
													"errorCode": "10002"
												}
											},
											{
												"name": "error_update_control_etl",
												"type": "Script",
												"dependsOn": [
													{
														"activity": "incrmtl_fail_after_copy",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"linkedServiceName": {
													"referenceName": "LS_Azuresql",
													"type": "LinkedServiceReference"
												},
												"typeProperties": {
													"scripts": [
														{
															"type": "Query",
															"text": {
																"value": "update dbo.control_ETL set error_message = 'Incremental load Copy failed' where source_schema = @{item().source_schema} and source_table = @{item().source_table}",
																"type": "Expression"
															}
														}
													],
													"scriptBlockExecutionTimeout": "02:00:00"
												}
											}
										]
									}
								]
							}
						}
					]
				}
			},
			{
				"name": "get_table_names",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select a.source_schema,a.source_table,a.load_type,a.cdc_column,a.target_container,a.target_folder,b.last_watermark,b.last_run_pipeline_id,b.status,b.updated_at from control_ETL as b INNER join control_rawdata as a on a.source_table = b.source_table where a.is_active > 0 and a.load_type = 'full'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_sql",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "pipeline_fails",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "get_table_names",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "'Failed to fetch meta data details of tables from SQL server'",
						"type": "Expression"
					},
					"errorCode": "10001"
				}
			}
		],
		"parameters": {
			"from_date": {
				"type": "string"
			}
		},
		"variables": {
			"lastcdc_tobe_updated": {
				"type": "String"
			},
			"currentdate": {
				"type": "String"
			}
		},
		"annotations": []
	}
}