{
	"name": "Data_ingestion_loop_copy_1",
	"properties": {
		"activities": [
			{
				"name": "looping_tablename",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "get_table_names",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('get_table_names').output.value",
						"type": "Expression"
					},
					"batchCount": 10,
					"activities": [
						{
							"name": "datacopied_or_not",
							"type": "IfCondition",
							"dependsOn": [
								{
									"activity": "get_rowscopied",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"expression": {
									"value": "@greater(activity('get_rowscopied').output.value[0].rows_written,0)",
									"type": "Expression"
								},
								"ifFalseActivities": [
									{
										"name": "delete_empty_file",
										"type": "Delete",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"typeProperties": {
											"dataset": {
												"referenceName": "DS_ADLS_gen2",
												"type": "DatasetReference",
												"parameters": {
													"container": {
														"value": "@item().target_container",
														"type": "Expression"
													},
													"folder": {
														"value": "@item().target_folder",
														"type": "Expression"
													},
													"file": {
														"value": "@concat(item().source_table,'_',variables('currentdate'))",
														"type": "Expression"
													}
												}
											},
											"enableLogging": false,
											"storeSettings": {
												"type": "AzureBlobFSReadSettings",
												"recursive": true,
												"enablePartitionDiscovery": false
											}
										}
									}
								],
								"ifTrueActivities": [
									{
										"name": "update_control_ETL",
										"type": "Script",
										"dependsOn": [],
										"policy": {
											"timeout": "0.12:00:00",
											"retry": 0,
											"retryIntervalInSeconds": 30,
											"secureOutput": false,
											"secureInput": false
										},
										"userProperties": [],
										"linkedServiceName": {
											"referenceName": "LS_Azuresql",
											"type": "LinkedServiceReference"
										},
										"typeProperties": {
											"scripts": [
												{
													"type": "Query",
													"text": {
														"value": "update dbo.control_ETL set status = 'Success', last_run_pipeline_id = '@{pipeline().RunId}', updated_at = getutcdate() where source_schema = '@{item().source_schema}' and source_table = '@{item().source_table}'",
														"type": "Expression"
													}
												}
											],
											"scriptBlockExecutionTimeout": "02:00:00"
										}
									}
								]
							}
						},
						{
							"name": "current_timestamp",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "currentdate",
								"value": {
									"value": "@formatDateTime(utcNow(),'yyyyMMdd_HHmmss')",
									"type": "Expression"
								}
							}
						},
						{
							"name": "loadtype_check",
							"type": "Switch",
							"dependsOn": [
								{
									"activity": "current_timestamp",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"on": {
									"value": "@item().load_type",
									"type": "Expression"
								},
								"cases": [
									{
										"value": "full",
										"activities": [
											{
												"name": "Copy_full",
												"type": "Copy",
												"dependsOn": [],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "AzureSqlSource",
														"sqlReaderQuery": {
															"value": "select * from @{item().source_schema}.@{item().source_table} where @{item().cdc_column} > '@{if(empty(pipeline().parameters.from_date),item().updated_at,pipeline().parameters.from_date)}'\n\n",
															"type": "Expression"
														},
														"queryTimeout": "02:00:00",
														"partitionOption": "None"
													},
													"sink": {
														"type": "ParquetSink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings"
														},
														"formatSettings": {
															"type": "ParquetWriteSettings"
														}
													},
													"enableStaging": false,
													"translator": {
														"type": "TabularTranslator",
														"typeConversion": true,
														"typeConversionSettings": {
															"allowDataTruncation": true,
															"treatBooleanAsNumber": false
														}
													}
												},
												"inputs": [
													{
														"referenceName": "DS_sql",
														"type": "DatasetReference"
													}
												],
												"outputs": [
													{
														"referenceName": "DS_ADLS_gen2",
														"type": "DatasetReference",
														"parameters": {
															"container": {
																"value": "@item().target_container",
																"type": "Expression"
															},
															"folder": {
																"value": "@item().target_folder",
																"type": "Expression"
															},
															"file": {
																"value": "@concat(item().source_table,'_',variables('currentdate'),'.parquet')",
																"type": "Expression"
															}
														}
													}
												]
											},
											{
												"name": "rows_read_written",
												"type": "Script",
												"dependsOn": [
													{
														"activity": "Copy_full",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"linkedServiceName": {
													"referenceName": "LS_Azuresql",
													"type": "LinkedServiceReference"
												},
												"typeProperties": {
													"scripts": [
														{
															"type": "Query",
															"text": {
																"value": "update dbo.control_ETL set rows_read = @{activity('Copy_full').output.rowsread}, rows_written = @{activity('Copy_full').output.rowscopied} where source_schema = '@{item().source_schema}' and source_table = '@{item().source_table}'",
																"type": "Expression"
															}
														}
													],
													"scriptBlockExecutionTimeout": "02:00:00"
												}
											}
										]
									},
									{
										"value": "incremental_load",
										"activities": [
											{
												"name": "Copy_incremental",
												"type": "Copy",
												"dependsOn": [],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "AzureSqlSource",
														"sqlReaderQuery": {
															"value": "select * from @{item().source_schema}.@{item().source_table} where @{item().cdc_column} > '@{if(empty(pipeline().parameters.from_date),item().updated_at,pipeline().parameters.from_date)}'\n\n",
															"type": "Expression"
														},
														"queryTimeout": "02:00:00",
														"partitionOption": "None"
													},
													"sink": {
														"type": "ParquetSink",
														"storeSettings": {
															"type": "AzureBlobFSWriteSettings"
														},
														"formatSettings": {
															"type": "ParquetWriteSettings"
														}
													},
													"enableStaging": false,
													"translator": {
														"type": "TabularTranslator",
														"typeConversion": true,
														"typeConversionSettings": {
															"allowDataTruncation": true,
															"treatBooleanAsNumber": false
														}
													}
												},
												"inputs": [
													{
														"referenceName": "DS_sql",
														"type": "DatasetReference"
													}
												],
												"outputs": [
													{
														"referenceName": "DS_ADLS_gen2",
														"type": "DatasetReference",
														"parameters": {
															"container": {
																"value": "@item().target_container",
																"type": "Expression"
															},
															"folder": {
																"value": "@item().target_folder",
																"type": "Expression"
															},
															"file": {
																"value": "@concat(item().source_table,'_',variables('currentdate'),'.parquet')",
																"type": "Expression"
															}
														}
													}
												]
											},
											{
												"name": "last_watermark",
												"type": "Lookup",
												"dependsOn": [
													{
														"activity": "Copy_incremental",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"typeProperties": {
													"source": {
														"type": "AzureSqlSource",
														"sqlReaderQuery": {
															"value": "select max(@{item().cdc_column}) as cdc from @{item().source_schema}.@{item().source_table} where @{item().cdc_column} > '@{item().last_watermark}'",
															"type": "Expression"
														},
														"queryTimeout": "02:00:00",
														"partitionOption": "None"
													},
													"dataset": {
														"referenceName": "DS_sql",
														"type": "DatasetReference"
													}
												}
											},
											{
												"name": "incremental_rowsread_written",
												"type": "Script",
												"dependsOn": [
													{
														"activity": "last_watermark",
														"dependencyConditions": [
															"Succeeded"
														]
													}
												],
												"policy": {
													"timeout": "0.12:00:00",
													"retry": 0,
													"retryIntervalInSeconds": 30,
													"secureOutput": false,
													"secureInput": false
												},
												"userProperties": [],
												"linkedServiceName": {
													"referenceName": "LS_Azuresql",
													"type": "LinkedServiceReference"
												},
												"typeProperties": {
													"scripts": [
														{
															"type": "Query",
															"text": {
																"value": "update dbo.control_etl set rows_read = @{activity('Copy_incremental').output.rowsread}, rows_written = @{activity('Copy_incremental').output.rowscopied}, last_watermark = '@{activity('last_watermark').output.firstRow.cdc}' where source_schema = '@{item().source_schema}' and source_table = '@{item().source_table}'",
																"type": "Expression"
															}
														}
													],
													"scriptBlockExecutionTimeout": "02:00:00"
												}
											}
										]
									}
								]
							}
						},
						{
							"name": "get_rowscopied",
							"type": "Lookup",
							"dependsOn": [
								{
									"activity": "loadtype_check",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "select rows_written from dbo.control_ETL where source_schema = '@{item().source_schema}' and source_table = '@{item().source_table}'",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_sql",
									"type": "DatasetReference"
								},
								"firstRowOnly": false
							}
						}
					]
				}
			},
			{
				"name": "get_table_names",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select a.source_schema,a.source_table,a.load_type,a.cdc_column,a.target_container,a.target_folder,b.last_watermark,b.last_run_pipeline_id,b.status,b.updated_at from control_ETL as b INNER join control_rawdata as a on a.source_table = b.source_table where a.is_active > 0",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_sql",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "pipeline_fails",
				"type": "Fail",
				"dependsOn": [
					{
						"activity": "get_table_names",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"message": {
						"value": "'Failed to fetch meta data details of tables from SQL server'",
						"type": "Expression"
					},
					"errorCode": "10001"
				}
			}
		],
		"parameters": {
			"from_date": {
				"type": "string"
			}
		},
		"variables": {
			"lastcdc_tobe_updated": {
				"type": "String"
			},
			"currentdate": {
				"type": "String"
			}
		},
		"annotations": []
	}
}