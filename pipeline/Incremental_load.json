{
	"name": "Incremental_load",
	"properties": {
		"activities": [
			{
				"name": "Copy_incremental",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from @{pipeline().parameters.source_schema}.@{pipeline().parameters.source_table} where @{pipeline().parameters.cdc_column} > '@{if(empty(pipeline().parameters.from_date),pipeline().parameters.last_watermark,pipeline().parameters.from_date)}'",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_sql",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_gen2",
						"type": "DatasetReference",
						"parameters": {
							"container": {
								"value": "@pipeline().parameters.target_container",
								"type": "Expression"
							},
							"folder": {
								"value": "@pipeline().parameters.target_folder",
								"type": "Expression"
							},
							"file": {
								"value": "@concat(pipeline().parameters.source_table,'_',pipeline().parameters.currentdate_file,'.parquet')",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "data copied or not_incrmtl",
				"type": "IfCondition",
				"dependsOn": [
					{
						"activity": "Copy_incremental",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"expression": {
						"value": "@greater(activity('Copy_incremental').output.rowsCopied,0)",
						"type": "Expression"
					},
					"ifFalseActivities": [
						{
							"name": "delete_empty_file",
							"type": "Delete",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"dataset": {
									"referenceName": "DS_ADLS_gen2",
									"type": "DatasetReference",
									"parameters": {
										"container": {
											"value": "@pipeline().parameters.target_container",
											"type": "Expression"
										},
										"folder": {
											"value": "@pipeline().parameters.target_folder",
											"type": "Expression"
										},
										"file": {
											"value": "@concat(pipeline().parameters.source_table,'_',pipeline().parameters.currentdate_file,'.parquet')",
											"type": "Expression"
										}
									}
								},
								"enableLogging": false,
								"storeSettings": {
									"type": "AzureBlobFSReadSettings",
									"recursive": true,
									"enablePartitionDiscovery": false
								}
							}
						}
					],
					"ifTrueActivities": [
						{
							"name": "last_watermark",
							"type": "Lookup",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "AzureSqlSource",
									"sqlReaderQuery": {
										"value": "select max(@{pipeline().parameters.cdc_column}) as cdc from @{pipeline().parameters.source_schema}.@{pipeline().parameters.source_table} where @{pipeline().parameters.cdc_column} > '@{pipeline().parameters.last_watermark}'",
										"type": "Expression"
									},
									"queryTimeout": "02:00:00",
									"partitionOption": "None"
								},
								"dataset": {
									"referenceName": "DS_sql",
									"type": "DatasetReference"
								}
							}
						},
						{
							"name": "update_control_ETL_incrmtl",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "last_watermark",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_Azuresql",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "update dbo.control_ETL set status = 'Success', last_run_pipeline_id = '@{pipeline().RunId}', updated_at = getutcdate(), last_Watermark = '@{activity('last_watermark').output.firstRow.cdc}' where source_schema = '@{pipeline().parameters.source_schema}' and source_table = '@{pipeline().parameters.source_table}'",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "error_after_update_incrmtl",
							"type": "Script",
							"dependsOn": [
								{
									"activity": "update_control_ETL_incrmtl",
									"dependencyConditions": [
										"Failed"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"linkedServiceName": {
								"referenceName": "LS_Azuresql",
								"type": "LinkedServiceReference"
							},
							"typeProperties": {
								"scripts": [
									{
										"type": "Query",
										"text": {
											"value": "update dbo.control_ETL set error_message = 'Incremental load Pipeline failed while updating', status = 'Failed' where source_schema = '@{pipeline().parameters.source_schema}' and source_table = '@{pipeline().parameters.source_table}'",
											"type": "Expression"
										}
									}
								],
								"scriptBlockExecutionTimeout": "02:00:00"
							}
						},
						{
							"name": "Web_after_update_ETL",
							"type": "WebActivity",
							"dependsOn": [
								{
									"activity": "get_http_url_copy1",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": true,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "POST",
								"url": {
									"value": "@activity('get_http_url_copy1').output.value",
									"type": "Expression"
								},
								"body": {
									"value": "{\n    \"pipelineName\" : \"@{pipeline().Pipeline}\",\n    \"pipelineRunID\" : \"@{pipeline().RunId}\",\n    \"Status\" : \"Failed\",\n    \"Error Message\" : \"Incremental load Pipeline failed while updating\",\n    \"Load Type\" : \"@{pipeline().parameters.load_type}\",\n    \"Schema\" : \"@{pipeline().parameters.source_schema}\",\n    \"Table\" : \"@{pipeline().parameters.source_table}\",\n    \"Failure at\" : \"@{formatDateTime(utcNow(),'yyyy-MM-dd_HH:mm:ss')}\"\n}",
									"type": "Expression"
								}
							}
						},
						{
							"name": "get_http_url_copy1",
							"type": "WebActivity",
							"dependsOn": [
								{
									"activity": "error_after_update_incrmtl",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": true,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"linkedServices": [
									{
										"referenceName": "LS_Keyvault",
										"type": "LinkedServiceReference"
									}
								],
								"url": {
									"value": "https://azurekeyvaultyt.vault.azure.net/secrets/HTTP-post-req-URL/e851e4e13c094905aef7f9d62bed4c90?api-version=7.5",
									"type": "Expression"
								},
								"authentication": {
									"type": "MSI",
									"resource": "https://vault.azure.net"
								}
							}
						}
					]
				}
			},
			{
				"name": "error_after_copy_incrmtl",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Copy_incremental",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_Azuresql",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "update dbo.control_ETL set error_message = 'Incremental load Pipeline failed while copying', status = 'Failed' where source_schema = '@{pipeline().parameters.source_schema}' and source_table = '@{pipeline().parameters.source_table}'",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Web_after copy",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "get_http_url",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": true,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": {
						"value": "@activity('get_http_url').output.value",
						"type": "Expression"
					},
					"body": {
						"value": "{\n    \"pipelineName\" : \"@{pipeline().Pipeline}\",\n    \"pipelineRunID\" : \"@{pipeline().RunId}\",\n    \"Status\" : \"Failed\",\n    \"Error Message\" : \"Incremental load Pipeline failed while copying\",\n    \"Load Type\" : \"@{pipeline().parameters.load_type}\",\n    \"Schema\" : \"@{pipeline().parameters.source_schema}\",\n    \"Table\" : \"@{pipeline().parameters.source_table}\",\n    \"Failure at\" : \"@{formatDateTime(utcNow(),'yyyy-MM-dd_HH:mm:ss')}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "get_http_url",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "error_after_copy_incrmtl",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": true,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"linkedServices": [
						{
							"referenceName": "LS_Keyvault",
							"type": "LinkedServiceReference"
						}
					],
					"url": {
						"value": "https://azurekeyvaultyt.vault.azure.net/secrets/HTTP-post-req-URL/e851e4e13c094905aef7f9d62bed4c90?api-version=7.5",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			}
		],
		"parameters": {
			"source_schema": {
				"type": "string"
			},
			"source_table": {
				"type": "string"
			},
			"target_container": {
				"type": "string"
			},
			"target_folder": {
				"type": "string"
			},
			"currentdate_file": {
				"type": "string"
			},
			"from_date": {
				"type": "string"
			},
			"cdc_column": {
				"type": "string"
			},
			"last_watermark": {
				"type": "string"
			},
			"load_type": {
				"type": "string"
			}
		},
		"annotations": []
	}
}