{
	"name": "Full_load",
	"properties": {
		"activities": [
			{
				"name": "Copy_full",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "select * from @{pipeline().parameters.source_schema}.@{pipeline().parameters.source_table}\n\n",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "ParquetSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "ParquetWriteSettings"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_sql",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ADLS_gen2",
						"type": "DatasetReference",
						"parameters": {
							"container": {
								"value": "@pipeline().parameters.target_container",
								"type": "Expression"
							},
							"folder": {
								"value": "@pipeline().parameters.target_folder",
								"type": "Expression"
							},
							"file": {
								"value": "@concat(pipeline().parameters.source_table,'_',pipeline().parameters.currentdate_file,'.parquet')",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "update_control_ETL_full",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Copy_full",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_Azuresql",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "update dbo.control_ETL set status = 'Success', last_run_pipeline_id = '@{pipeline().RunId}', updated_at = getutcdate(),is_initial_load_completed = 1 where source_schema = '@{pipeline().parameters.source_schema}' and source_table = '@{pipeline().parameters.source_table}'",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "error_after_copy_full",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Copy_full",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_Azuresql",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "update dbo.control_ETL set error_message = 'Full load Pipeline failed while copying', status = 'Failed' where source_schema = '@{pipeline().parameters.source_schema}' and source_table = '@{pipeline().parameters.source_table}'",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "error_after_update_full",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "update_control_ETL_full",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "LS_Azuresql",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "update dbo.control_ETL set error_message = 'Full load Pipeline failed while updating', status = 'Failed' where source_schema = '@{pipeline().parameters.source_schema}' and source_table = '@{pipeline().parameters.source_table}'",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			},
			{
				"name": "Web_full_copy",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "get_http_url",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": {
						"value": "@activity('get_http_url').output.value",
						"type": "Expression"
					},
					"body": {
						"value": "{\n    \"pipelineName\" : \"@{pipeline().Pipeline}\",\n    \"pipelineRunID\" : \"@{pipeline().RunId}\",\n    \"Status\" : \"Failed\",\n    \"Error Message\" : \"Full load Pipeline failed while copying\",\n    \"Load Type\" : \"@{pipeline().parameters.load_type}\",\n    \"Schema\" : \"@{pipeline().parameters.source_schema}\",\n    \"Table\" : \"@{pipeline().parameters.source_table}\",\n    \"Failure at\" : \"@{formatDateTime(utcNow(),'yyyy-MM-dd_HH:mm:ss')}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Web_full_update",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "get_http_url_1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": true,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": {
						"value": "@activity('get_http_url_1').output.value",
						"type": "Expression"
					},
					"body": {
						"value": "{\n    \"pipelineName\" : \"@{pipeline().Pipeline}\",\n    \"pipelineRunID\" : \"@{pipeline().RunId}\",\n    \"Status\" : \"Failed\",\n    \"Error Message\" : \"Full load Pipeline failed while updating\",\n    \"Load Type\" : \"@{pipeline().parameters.load_type}\",\n    \"Schema\" : \"@{pipeline().parameters.source_schema}\",\n    \"Table\" : \"@{pipeline().parameters.source_table}\",\n    \"Failure at\" : \"@{formatDateTime(utcNow(),'yyyy-MM-dd_HH:mm:ss')}\"\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "get_http_url",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "error_after_copy_full",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": true,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"linkedServices": [
						{
							"referenceName": "LS_Keyvault",
							"type": "LinkedServiceReference"
						}
					],
					"url": {
						"value": "https://azurekeyvaultyt.vault.azure.net/secrets/HTTP-post-req-URL/e851e4e13c094905aef7f9d62bed4c90?api-version=7.5",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "get_http_url_1",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "error_after_update_full",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": true,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"linkedServices": [
						{
							"referenceName": "LS_Keyvault",
							"type": "LinkedServiceReference"
						}
					],
					"url": {
						"value": "https://azurekeyvaultyt.vault.azure.net/secrets/HTTP-post-req-URL/e851e4e13c094905aef7f9d62bed4c90?api-version=7.5",
						"type": "Expression"
					},
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			}
		],
		"parameters": {
			"source_schema": {
				"type": "string"
			},
			"source_table": {
				"type": "string"
			},
			"target_container": {
				"type": "string"
			},
			"target_folder": {
				"type": "string"
			},
			"currentdate_file": {
				"type": "string"
			},
			"load_type": {
				"type": "string"
			}
		},
		"annotations": []
	}
}